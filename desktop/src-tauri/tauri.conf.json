{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Infra Workbench",
  "version": "0.1.2",
  "identifier": "com.infra-workbench.desktop",
  "build": {
    "frontendDist": "../bootstrap"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "../../backend/assets/workbench.ico",
      "../../backend/assets/workbench.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNERjk3NjlBRkZGOTYxMjgKUldRb1lmbi9tbmI1UGJBK3VvOFU5TzlTbU1DVVA3am9tT3k2MlArdXBhcmF0L1hhOUFhSjZJNEsK",
      "endpoints": [
        "https://github.com/addsubmuldiv/infra-workbench/releases/latest/download/latest.json"
      ]
    }
  }
}
