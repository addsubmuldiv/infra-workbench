{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Infra Workbench",
  "version": "0.1.0",
  "identifier": "com.infra-workbench.desktop",
  "build": { "frontendDist": "../bootstrap" },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": ["icons/icon.icns", "../../backend/assets/workbench.ico", "../../backend/assets/workbench.png"],
    "windows": { "nsis": { "installMode": "currentUser" } },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
